{
  "name": "todone",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx local-dev/server.ts",
    "dev:cognito": "cognito-local",
    "dev:full": "concurrently -k -s first \"TODONE_API_PROXY_TARGET=http://localhost:3002 VITE_COGNITO_LOCAL_ENDPOINT=http://localhost:3001/cognito npm run dev -- --port 3001 --strictPort\" \"PORT=3002 npm run dev:api\" \"npm:dev:cognito\"",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:parent-activation": "playwright test --config=playwright.parent-activation.config.ts",
    "test:e2e:local-auth": "playwright test --config=playwright.local.config.ts",
    "test:a11y": "playwright test tests/a11y",
    "verify-local": "npm run format:check && npm run lint:check && npm run typecheck && npm run test:unit && npm run test:integration && npm run build && npm run build:lambdas && npx openspec validate --all --strict --no-interactive",
    "setup:local-cognito": "tsx scripts/setup-local-cognito.ts",
    "db:reset:local": "tsx scripts/reset-local-database.ts",
    "build:lambdas": "tsx scripts/build-and-deploy-lambdas.ts --build-only",
    "deploy:lambdas": "tsx scripts/build-and-deploy-lambdas.ts",
    "deploy:frontend": "tsx scripts/build-and-deploy-frontend.ts",
    "test:e2e:local-seed": "playwright test --config=playwright.local-seed.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "axe-core": "^4.12.1",
    "cognito-local": "^5.3.0",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1097.0",
    "@aws-sdk/client-dynamodb": "^3.1110.0",
    "@lucide/vue": "^1.31.0",
    "amazon-cognito-identity-js": "^6.3.20",
    "aws-jwt-verify": "^5.2.1",
    "express": "^5.2.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "yaml": "^2.9.0"
  }
}
